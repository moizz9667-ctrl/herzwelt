<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="description" content="{{ description or 'HerzWelt – Vollständige deutsche Geschichten über Liebe, Schicksal und Familie.' }}">
<title>{% if title %}{{ title }} – HerzWelt{% else %}HerzWelt – Deutsche Geschichten{% endif %}</title>
<meta property="og:title" content="{% if title %}{{ title }} – HerzWelt{% else %}HerzWelt – Deutsche Geschichten{% endif %}">
<meta property="og:description" content="{{ description or 'HerzWelt – Vollständige deutsche Geschichten über Liebe, Schicksal und Familie.' }}">
<meta property="og:image" content="{{ ogImage or 'https://www.herzwelt.xyz/assets/images/logo.png' }}">
<meta property="og:url" content="https://www.herzwelt.xyz{{ page.url }}">
<meta property="og:type" content="article">
<meta property="og:site_name" content="HerzWelt">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content="{{ ogImage or 'https://www.herzwelt.xyz/assets/images/logo.png' }}">
<link rel="icon" type="image/png" href="/assets/images/logo.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=Inter:wght@300;400;500;600;700&display=swap">
<link rel="stylesheet" href="/assets/css/style.css">
</head>
<body>

<!-- HEADER -->
<header class="site-header">
  <input type="checkbox" id="navToggle" class="nav-toggle-input">
  <div class="header-inner">
    <a href="/" class="site-logo">
      <img src="/assets/images/logo.png" alt="HerzWelt" width="200" height="56">
      <div class="logo-text">
        <span class="logo-name">Herz<em>Welt</em></span>
        <span class="logo-tagline">Deutsche Geschichten · Täglich neu</span>
      </div>
    </a>
    <ul class="nav-links" id="navLinks">
      <li><a href="/" {% if page.url == "/" %}class="active"{% endif %}>Home</a></li>
      <li><a href="/geschichten/" {% if "/geschichten" in page.url %}class="active"{% endif %}>Geschichten</a></li>
      <li><a href="/ueber-uns/" {% if "/ueber-uns" in page.url %}class="active"{% endif %}>Über uns</a></li>
      <li><a href="/kontakt/" {% if "/kontakt" in page.url %}class="active"{% endif %}>Kontakt</a></li>
    </ul>
    <div class="nav-actions">
      <label for="navToggle" class="nav-mobile-btn" aria-label="Menü öffnen">☰</label>
    </div>
  </div>
</header>

<!-- CONTENT -->
{{ content | safe }}

<!-- FOOTER -->
<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <div class="footer-logo">
        <img src="/assets/images/logo.png" alt="HerzWelt" height="56" style="width:auto;">
        <div class="logo-text">
          <span class="logo-name">Herz<em>Welt</em></span>
          <span class="logo-tagline">Deutsche Geschichten · Täglich neu</span>
        </div>
      </div>
      <p class="footer-desc">Vollständige fiktive Geschichten auf Deutsch — täglich neue Erzählungen über Liebe, Familie und menschliche Schicksale.</p>
    </div>
    <nav class="footer-nav">
      <div class="footer-col">
        <h4>Navigation</h4>
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/geschichten/">Alle Geschichten</a></li>
          <li><a href="/ueber-uns/">Über uns</a></li>
          <li><a href="/kontakt/">Kontakt</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>Rechtliches</h4>
        <ul>
          <li><a href="/impressum/">Impressum</a></li>
          <li><a href="/datenschutz/">Datenschutz</a></li>
        </ul>
      </div>
    </nav>
  </div>
  <div class="footer-bottom">
    <span class="footer-copy">© 2026 HerzWelt. Alle Geschichten sind fiktiv. Alle Rechte vorbehalten.</span>
  </div>
</footer>

<script src="/assets/js/main.js"></script>

<!-- NATIVE BANNER (in-feed style, before footer) -->
<div class="native-ad-wrap" id="nativeAdWrap">
  <div class="native-ad-inner">
    <span class="native-ad-label">Anzeige</span>
    <div style="text-align:center;">
      <script>atOptions={'key':'b3da07f00e389d2957ee51076c75c8f9','format':'iframe','height':50,'width':320,'params':{}};</script>
      <script src="https://brightlakegarden.com/b3da07f00e389d2957ee51076c75c8f9/invoke.js"></script>
    </div>
  </div>
</div>

<!-- SOCIAL BAR (sticky bottom) -->
<div class="social-bar" id="socialBar">
  <div class="social-bar-inner">
    <span class="social-bar-label">Gesponsert</span>
    <div class="social-bar-ad">
      <script>atOptions={'key':'b3da07f00e389d2957ee51076c75c8f9','format':'iframe','height':50,'width':320,'params':{}};</script>
      <script src="https://brightlakegarden.com/b3da07f00e389d2957ee51076c75c8f9/invoke.js"></script>
    </div>
    <button class="social-bar-close" onclick="document.getElementById('socialBar').style.display='none'" aria-label="Schließen">✕</button>
  </div>
</div>

<style>
/* Native Banner */
.native-ad-wrap {
  max-width: 760px;
  margin: 2rem auto 0;
  padding: 0 1rem 2rem;
}
.native-ad-inner {
  border: 1px solid #e5e7eb;
  border-radius: 10px;
  padding: 1rem;
  background: #fafafa;
  text-align: center;
}
.native-ad-label {
  display: block;
  font-size: 0.65rem;
  letter-spacing: .08em;
  text-transform: uppercase;
  color: #9ca3af;
  margin-bottom: .5rem;
}
@media (prefers-color-scheme: dark) {
  .native-ad-inner { background: #1a1a1a; border-color: #333; }
}

/* Social Bar */
.social-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 999;
  background: #fff;
  border-top: 1px solid #e5e7eb;
  box-shadow: 0 -2px 12px rgba(0,0,0,.08);
  padding: .4rem 1rem;
}
.social-bar-inner {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: .75rem;
  max-width: 760px;
  margin: 0 auto;
  position: relative;
}
.social-bar-label {
  font-size: 0.6rem;
  letter-spacing: .08em;
  text-transform: uppercase;
  color: #9ca3af;
  white-space: nowrap;
}
.social-bar-ad { line-height: 0; }
.social-bar-close {
  background: none;
  border: none;
  cursor: pointer;
  font-size: .8rem;
  color: #9ca3af;
  padding: .25rem .4rem;
  line-height: 1;
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
}
.social-bar-close:hover { color: #374151; }
@media (prefers-color-scheme: dark) {
  .social-bar { background: #111; border-color: #333; }
  .social-bar-close:hover { color: #e5e7eb; }
}
/* Body padding so footer content not hidden behind bar */
body { padding-bottom: 66px; }
</style>
</body>
</html>
